{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": []
  },
  "include": [
    "extension/**/*.js",
    "extension/**/*.mjs"
  ],
  "exclude": [
    "extension/test",
    "extension/vendor",
    "extension/node_modules",
    "extension/**/*.min.js"
  ]
}
