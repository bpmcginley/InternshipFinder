{
  "manifest_version": 3,
  "name": "InternScout Auto-Apply",
  "version": "0.3.0",
  "description": "Walks every step of an internship application, fills it from your Deep Dive profile, and stops at the submit button for you.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "tabs",
    "tabGroups",
    "scripting",
    "webNavigation",
    "sidePanel",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/index.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://bpmcginley.github.io/InternshipFinder/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "bridge/bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "InternScout Auto-Apply",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "web_accessible_resources": [],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
